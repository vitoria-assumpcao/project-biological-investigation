;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Projeto_Biological_Investigation"
run/main_scene="uid://c330nlqj0ocwm"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
ClueManager="*uid://boavmibfwfo10"
Transition="*uid://d138qshg810wn"

[dialogue_manager]

runtime/balloon_path="res://Dialogues/balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=160
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[input]

cliqueEsquerdo={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[internationalization]

